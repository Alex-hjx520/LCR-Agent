# =============================================================================
# LCR-Agent 环境变量模板  —— 复制为 .env 后按需修改
#     cp .env.example .env
# 所有变量均可使用 LCR_ 前缀（如 LCR_LLM_MODEL），LLM 相关变量同时兼容
# 社区通用的裸名称（OPENAI_API_KEY / OPENAI_BASE_URL）。
# =============================================================================

# ---------------- 应用 ----------------
LCR_APP_ENV=dev
LCR_LOG_LEVEL=INFO
LCR_API_HOST=0.0.0.0
LCR_API_PORT=8000
LCR_API_CORS_ORIGINS=["http://localhost:5173"]

# ---------------- LLM ----------------
# 兼容 OpenAI / DeepSeek / Qwen / vLLM 等任意 OpenAI-兼容端点
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LCR_LLM_MODEL=gpt-4o-mini
LCR_LLM_TEMPERATURE=0
LCR_LLM_MAX_TOKENS=2048
LCR_LLM_TIMEOUT=60
LCR_LLM_MAX_RETRIES=2

# ---------------- Embedding ----------------
# 中文合同强烈建议 BAAI/bge-m3 或 BAAI/bge-large-zh-v1.5
LCR_EMBEDDING_BACKEND=sentence-transformers
LCR_EMBEDDING_MODEL=BAAI/bge-m3
LCR_EMBEDDING_DEVICE=cpu
LCR_EMBEDDING_BATCH_SIZE=32
LCR_EMBEDDING_DIM=1024

# ---------------- 向量库 (Chroma) ----------------
LCR_CHROMA_DIR=./data/index/chroma
LCR_CHROMA_COLLECTION=cuad_clauses

# ---------------- 检索 ----------------
LCR_TOP_K=5
LCR_TOP_K_VECTOR=20
LCR_TOP_K_BM25=20
LCR_RRF_K=60
LCR_MIN_SCORE=0.2

# ---------------- 语料 ----------------
LCR_CUAD_DIR=./data/cuad
LCR_CUAD_FILE=CUAD_v1.json
LCR_CONFIGS_DIR=./configs
LCR_DEFAULT_CONFIG=default.yaml

# ---------------- 切分 ----------------
LCR_CHUNK_SIZE=800
LCR_CHUNK_OVERLAP=120
LCR_CHUNK_ENCODING=cl100k_base
